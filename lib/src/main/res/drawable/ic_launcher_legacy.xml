<?xml version="1.0" encoding="utf-8"?>
<!--
  静态图标（Android 7.x 及以下，无自适应图标机制）
  把背景渐变与前景图形合并成一张矢量图
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 背景渐变 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF2E77DB" />
                <item android:offset="0.55" android:color="#FF1B57B8" />
                <item android:offset="1" android:color="#FF12408C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 车牌外框 -->
    <path
        android:pathData="M32,38 L76,38 A5,5 0 0 1 81,43 L81,65 A5,5 0 0 1 76,70 L32,70 A5,5 0 0 1 27,65 L27,43 A5,5 0 0 1 32,38 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.4"
        android:fillColor="#00000000"
        android:strokeLineJoin="round" />

    <!-- 顶部两个安装孔 -->
    <path
        android:pathData="M38.5,45.6 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M69.5,45.6 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0"
        android:fillColor="#FFFFFFFF" />

    <!-- 对勾 -->
    <path
        android:pathData="M41,57.6 L47.6,63.6 L67,46.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:strokeLineJoin="round" />
</vector>
